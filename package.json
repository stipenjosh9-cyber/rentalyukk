{
  "name": "rentalyuk-pro",
  "version": "2.0.0",
  "description": "Sistem Manajemen Sewa dengan TypeScript & SCSS",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=esm && sass src/styles.scss dist/styles.css",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=esm --watch & sass --watch src/styles.scss dist/styles.css"
  },
  "keywords": [
    "rental",
    "typescript",
    "scss"
  ],
  "author": "Jules",
  "license": "ISC",
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "esbuild": "^0.27.2",
    "sass": "^1.97.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "jspdf": "^3.0.4"
  }
}
